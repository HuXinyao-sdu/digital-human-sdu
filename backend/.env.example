# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 外部 RAG 系统地址（可选；留空时使用本仓库的已审核校史知识库）
RAG_API_URL=
RAG_API_KEY=
# 仅在需要代理另一套 RAG 服务时设为 true；默认使用本仓库本地知识库。
RAG_USE_EXTERNAL_API=false

# 本地校史知识库（默认 data/history/sdu_archive.json，通常不必填写）
RAG_KNOWLEDGE_PATH=

# DeepSeek 生成（可选；留空时返回本地检索到的可溯源事实摘要）
# 填写 DEEPSEEK_API_KEY 后，将 RAG_USE_LLM 改为 true。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 设为 true 后，才会使用 DeepSeek 在检索到的资料范围内生成回答。
RAG_USE_LLM=false

# 语义检索（配置兼容 OpenAI /embeddings 的服务后，运行重建索引脚本）
# 未配置 Embedding 服务时保留 false，仍会使用关键词检索与重排序。
RAG_USE_SEMANTIC=false
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_TIMEOUT=30
# 千问 qwen3.7-text-embedding-flash 单批最多 20 条；其他服务按其文档调整。
RAG_EMBEDDING_BATCH_SIZE=20
# 留空时使用 data/history/.rag-semantic-index.json
RAG_INDEX_PATH=

# 二次重排序（可选；千问 qwen3-rerank 使用 compatible-api，而非 compatible-mode）
RAG_USE_RERANK=false
RAG_RERANK_API_KEY=
RAG_RERANK_BASE_URL=https://maas.qianwenaiapi.com/compatible-api/v1
RAG_RERANK_MODEL=qwen3-rerank
RAG_RERANK_CANDIDATES=12
RAG_RERANK_TIMEOUT=30

# 多轮上下文存入本地 SQLite；留空时使用 data/rag-sessions.sqlite3
RAG_SESSION_MAX_TURNS=5
RAG_SESSION_TTL_SECONDS=3600
RAG_SESSION_DB_PATH=

# MiniMax 语音合成（请从 MiniMax 开放平台创建 API Key 与音色 ID）
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=

# 音频缓存目录；本地留空即可，Docker 中可设为 /data/generated-audio
AUDIO_CACHE_PATH=

# 内容数据路径
CONTENT_DATA_PATH=/data

# 联网兜底（Tavily 搜索），不会自动入库。与 RAG_API_URL 代理模式不同。
# 启用后走本地+联网补证路径；TAVILY_API_KEY 需另行申请，不能填写 DeepSeek Key。
RAG_WEB_ENABLED=false
TAVILY_API_KEY=
RAG_WEB_TIMEOUT=45
RAG_WEB_GATE_TIMEOUT=6
RAG_WEB_CACHE_SECONDS=300
RAG_WEB_MAX_RESULTS=5

# 单次联网请求上限，与45秒总预算分开
RAG_WEB_REQUEST_TIMEOUT=15
