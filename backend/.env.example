# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# RAG系统API地址（接入实际RAG时填写，留空则使用模拟回答）
RAG_API_URL=
RAG_API_KEY=

# MiniMax 语音合成（请从 MiniMax 开放平台创建 API Key 与音色 ID）
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=

# 音频缓存目录；本地留空即可，Docker 中可设为 /data/generated-audio
AUDIO_CACHE_PATH=

# 内容数据路径
CONTENT_DATA_PATH=/data
