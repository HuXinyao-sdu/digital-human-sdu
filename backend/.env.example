# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 外部 RAG 系统地址（可选；留空时使用本仓库的已审核校史知识库）
RAG_API_URL=
RAG_API_KEY=
# 仅在需要代理另一套 RAG 服务时设为 true；默认使用本仓库本地知识库。
RAG_USE_EXTERNAL_API=false

# 本地校史知识库（默认 data/history/sdu_archive.json，通常不必填写）
RAG_KNOWLEDGE_PATH=

# DeepSeek 生成（可选；留空时返回本地检索到的可溯源事实摘要）
# 填写 DEEPSEEK_API_KEY 后，将 RAG_USE_LLM 改为 true。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 设为 true 后，才会使用 DeepSeek 在检索到的资料范围内生成回答。
RAG_USE_LLM=false

# 语义检索（配置兼容 OpenAI /embeddings 的服务后，运行重建索引脚本）
# 未配置 Embedding 服务时保留 false，仍会使用关键词检索与重排序。
RAG_USE_SEMANTIC=false
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_TIMEOUT=30
# 留空时使用 data/history/.rag-semantic-index.json
RAG_INDEX_PATH=

# 多轮上下文只在内存中保存，服务重启后自动清空
RAG_SESSION_MAX_TURNS=5
RAG_SESSION_TTL_SECONDS=3600

# MiniMax 语音合成（请从 MiniMax 开放平台创建 API Key 与音色 ID）
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=

# 音频缓存目录；本地留空即可，Docker 中可设为 /data/generated-audio
AUDIO_CACHE_PATH=

# 内容数据路径
CONTENT_DATA_PATH=/data
